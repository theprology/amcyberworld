# MySQL/MariaDB database created in CyberPanel or cPanel
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=replace_with_database_password

# Use a long, private value for access to /agent
AGENT_ACCESS_CODE=replace_with_a_long_random_access_code

# Optional: a direct Telegram contact such as https://t.me/your_username
TELEGRAM_CONTACT_URL=

# Optional. The default is ./storage/uploads inside the application directory.
UPLOAD_DIR=
